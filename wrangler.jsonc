{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "poolscoreboard",
  "main": "src/app.ts",
  "compatibility_date": "2025-09-06",
  "workers_dev": true,
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "poolscoreboard-prod",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
